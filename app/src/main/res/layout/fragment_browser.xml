<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.myAllVideoBrowser.ui.main.home.browser.BrowserViewModel" />
    </data>

    <com.myAllVideoBrowser.ui.component.widget.SafeDrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.myAllVideoBrowser.ui.main.home.browser.CustomViewPager2
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                app:currentItem="@{viewModel.currentTab}"
                app:items="@{viewModel.tabs}" />

            <LinearLayout
                android:id="@+id/browser_tab_bar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/colorSurfaceContainer"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/browser_back_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/accessibility_back"
                    android:onClick="@{() -> viewModel.onBottomBackClicked()}"
                    app:icon="@drawable/arrow_back24px"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/browser_forward_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/accessibility_forward"
                    android:onClick="@{() -> viewModel.onBottomForwardClicked()}"
                    app:icon="@drawable/arrow_forward24px"
                    app:iconTint="?attr/colorOnSurface" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/browser_tabs_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:contentDescription="@string/accessibility_tabs"
                    android:minWidth="72dp"
                    android:onClick="@{() -> viewModel.onShowTabsClicked()}"
                    android:text="1"
                    app:icon="@drawable/tab_group_24px"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/browser_new_tab_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/accessibility_new_tab"
                    android:onClick="@{() -> viewModel.onNewTabClicked()}"
                    app:icon="@drawable/add_24px"
                    app:iconTint="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigation_view"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:layout_gravity="start">

            <LinearLayout
                android:id="@+id/drawer_layout_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="16dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="16dp"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tabs_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    android:contentDescription="@string/tabs"
                    app:items="@{viewModel.tabs}"
                    app:selectedTab="@{viewModel.currentTab}" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawer_new_tab"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:contentDescription="@string/accessibility_new_tab"
                    android:onClick="@{() -> viewModel.onNewTabClicked()}"
                    android:text="@string/new_tab"
                    app:icon="@drawable/add_24px" />

            </LinearLayout>
        </com.google.android.material.navigation.NavigationView>

    </com.myAllVideoBrowser.ui.component.widget.SafeDrawerLayout>

</layout>